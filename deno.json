{
  "nodeModulesDir": "none",
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --allow-write=.dev dev/server.ts",
    "test": "deno test --allow-read tests/",
    "check": "deno check supabase/functions/api/index.ts dev/server.ts && deno lint && deno fmt --check"
  },
  "fmt": {
    "lineWidth": 100,
    "include": [
      "supabase/",
      "dev/",
      "tests/",
      "web/",
      "docs/",
      ".github/",
      "deno.json"
    ],
    "exclude": [
      "README.md",
      "supabase/migrations/",
      "web/node_modules/",
      "web/dist/",
      "web/src/components/ui/",
      "web/src/hooks/",
      "web/src/index.css",
      "web/index.html",
      "web/package.json",
      "web/package-lock.json",
      "web/components.json",
      "web/tsconfig*.json"
    ]
  },
  "lint": {
    "include": [
      "supabase/",
      "dev/",
      "tests/",
      "web/"
    ],
    "exclude": [
      "web/node_modules/",
      "web/dist/",
      "web/src/components/ui/",
      "web/src/hooks/",
      "web/public/config.js"
    ],
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-import-prefix",
        "no-window",
        "no-window-prefix"
      ]
    }
  },
  "lock": false
}
