{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --allow-write=.dev dev/server.ts",
    "test": "deno test --allow-read tests/",
    "check": "deno check supabase/functions/api/index.ts dev/server.ts && deno lint && deno fmt --check"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "README.md",
      "supabase/migrations/",
      "app/node_modules/",
      "app/dist/",
      "app/src/components/ui/",
      "app/src/hooks/",
      "app/src/index.css",
      "app/index.html",
      "app/package.json",
      "app/package-lock.json",
      "app/components.json",
      "app/tsconfig*.json"
    ]
  },
  "lint": {
    "exclude": [
      "app/node_modules/",
      "app/dist/",
      "app/src/components/ui/",
      "app/src/hooks/",
      "app/public/config.js"
    ],
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-import-prefix",
        "no-window",
        "no-window-prefix"
      ]
    }
  },
  "lock": false
}
